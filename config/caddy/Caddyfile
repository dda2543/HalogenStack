# halogen-stack reverse-proxy (фаза 1): HTTP в LAN, TLS — фаза 2 (waf-firewall).
# Маршруты:
#   Host = PUBLIC_DOMAIN + /v1/* или /healthz — 403 (публичный путь: только
#                web-ui; LLM API и /healthz, отдающий версию движка, наружу не
#                отдаются — решение от 2026-10-28)
#   /v1/*   — LLM API: forward-auth к internal-auth-provider, затем halogen
#   /healthz — открытый health halogen, ТОЛЬКО с LAN-пути (диагностика)
#   всё остальное — web-ui

{
	admin off
	auto_https off
}

:8080 {
	# Публичный путь (от waf-firewall) — только web-ui: наружу не светятся ни
	# LLM API, ни /healthz (он отдаёт версию halogen). Спуфить Host на LAN-пути
	# можно, но это запрет самому себе — ключей такой трюк не обходит
	# (forward-auth всё равно спрашивает auth-provider).
	@public_halogen {
		header Host {$PUBLIC_DOMAIN}
		path /v1 /v1/* /healthz
	}
	handle @public_halogen {
		respond "forbidden" 403
	}

	@health path /healthz
	handle @health {
		# у halogen открыт /health, а не /healthz — иначе 404 от uvicorn.
		rewrite /health
		reverse_proxy halogen-flash-server:8731
	}

	# /v1 без слэша — тоже API (иначе провалится в handle ниже, к web-ui).
	@api path /v1 /v1/*
	handle @api {
		forward_auth internal-auth-provider:9000 {
			# '?' в конце гасит query-строку: иначе Caddy передаёт её на /authz
			# вместе с query исходного запроса (rewrite.go: RawQuery меняется
			# только при наличии '?' в uri).
			uri /authz?
			copy_headers Authorization X-Api-Key
		}
		reverse_proxy halogen-flash-server:8731 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web-ui:8080 {
			flush_interval -1
		}
	}
}
