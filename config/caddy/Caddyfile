# halogen-stack reverse-proxy (фаза 1): HTTP в LAN, TLS — фаза 2 (waf-firewall).
# Маршруты:
#   /v1/*   — LLM API: forward-auth к internal-auth-provider, затем halogen
#   /healthz — открытый health halogen (для диагностики)
#   всё остальное — web-ui

{
	admin off
	auto_https off
}

:8080 {
	@health path /healthz
	handle @health {
		reverse_proxy halogen-flash-server:8731
	}

	@api path /v1/*
	handle @api {
		forward_auth internal-auth-provider:9000 {
			uri /authz
			copy_headers Authorization X-Api-Key
		}
		reverse_proxy halogen-flash-server:8731 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web-ui:8080 {
			flush_interval -1
		}
	}
}
