# Скопировать в .env и заполнить (`make init`). .env в git не попадает.

# IP LAN-интерфейса сервера: на него биндится LLM API (8731). НЕ 0.0.0.0.
LAN_IP=192.168.101.50

# Каталог с моделями halogen-flash-server (см. reference README: hf download ...)
HALOGEN_MODELS_DIR=/home/USER/halogen-models

# Каталог дискового prompt-кэша halogen (в контейнере — /cache). С 2026-11-12
# обязателен: под кэш выделен отдельный диск, ext4, точка монтирования
# /srv/halogen-cache, сам каталог — подкаталог prompt-cache на НЁМ (поэтому без
# монтирования podman не сможет его создать и запустится не сможет).
# GUARD_CACHE_DIR в Makefile требует, чтобы путь был задан и лежал на
# примонтированном устройстве; подробности и порядок разметки —
# docs/admin-cache-disk.md. Пробелов в пути guard не терпит.
HALOGEN_CACHE_DIR_HOST=/srv/halogen-cache/prompt-cache

# Каталог с секретами (keys.acl)
SECRETS_DIR=./secrets

# Сервисный ключ web-ui: значение записи `webui` из secrets/keys.acl
# (создать: make key-add NAME=webui, значение вставить сюда)
WEBUI_SERVICE_KEY=

# Секрет Open WebUI: openssl rand -hex 32
WEBUI_SECRET_KEY=

# --- Фаза 2 (публичный вход WebUI через waf-firewall) ---

# Публичное имя WebUI. Предпосылка: DNS-запись должна указывать на IP сервера.
PUBLIC_DOMAIN=ai.dda2543.ru

# Каталог на хосте, куда certbot (deploy-hook) кладёт копию сертификата для
# rootless-контейнера waf. Должен принадлежать администратору хоста.
CERTS_DIR=./secrets/certs

# Адрес хоста, на котором публикуется 443 (waf-firewall). Пусто = 0.0.0.0.
# После настройки VLAN (§3.1 архитектуры) сюда ставят адрес WAN/VLAN-интерфейса
# сервера — тогда публичный вход нельзя обойти из LAN напрямую. До VLAN пустое
# значение осознанно: адрес WAN у хоста ещё не закреплён.
PUBLIC_BIND_IP=
